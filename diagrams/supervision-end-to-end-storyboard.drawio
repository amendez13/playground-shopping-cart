<mxfile host="drawio" version="24.7.17"><diagram id="supervision-end-to-end-storyboard" name="Supervision end-to-end storyboard"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2104" pageHeight="1564" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s1" value="&lt;b&gt;Supervision end to end: from service registration to the user's chart&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=19;fontColor=#1f2933;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="2044" height="30" as="geometry"/></mxCell><mxCell id="s2" value="Simplified storyboard. The RP registers a service once; a user requests it for a start datetime; from then on collection runs without any user. Names, ids and values are fake." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#5f6b7a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="2044" height="22" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;Service registration&lt;/b&gt;  &lt;span style='color:#5f6b7a;font-weight:normal'&gt;(once per service, by the resource provider)&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1f2933;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230" y="106" width="1400" height="26" as="geometry"/></mxCell><mxCell id="s4" value="" style="rounded=1;arcSize=6;html=1;fillColor=#f4f6f8;strokeColor=#d4d9e0;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="150" height="200" as="geometry"/></mxCell><mxCell id="s5" value="" style="shape=mxgraph.office.users.user;html=1;fillColor=#b08a1e;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="82" y="208" width="66" height="88" as="geometry"/><