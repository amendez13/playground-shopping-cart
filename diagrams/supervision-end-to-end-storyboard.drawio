or=#1f2933;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="634" y="254" width="320" height="30" as="geometry"/></mxCell><mxCell id="s52" value="RP-B" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#1f2933;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="784" y="254" width="320" height="30" as="geometry"/></mxCell><mxCell id="s53" value="https://pm.rp-b.example.test/v2" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#1f2933;align=left;verticalAlign=middle;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="924" y="254" width="320" height="30" as="geometry"/></mxCell><mxCell id="s54" value="30" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#1f2933;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1254" y="254" width="320" height="30" as="geometry"/></mxCell><mxCell id="s55" value="10 s · 60 s · 300 s" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#1f2933;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1394" y="254" width="320" height="30" as="geometry"/></mxCell><mxCell id="s56" value="" style="rounded=0;arcSize=0;html=1;fillColor=#ffffff;strokeColor=#e3e7ec;" vertex="1" parent="1"><mxGeometry x="622" y="284" width="1426" height="30" as="geometry"/></mxCell><mxCell id="s57" value="S-300" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#1f2933;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="634" y="284" width="320" height="30" as="geometry"/></mxCell><mxCell id="s58" value="RP-C" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#1f2933;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="784" y="284" width="320" height="30" as="geometry"/></mxCell><mxCell id="s59" value="https://api.rp-c.example.test/pm" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#1f2933;align=left;verticalAlign=middle;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="924" y="284" width="320" height="30" as="geometry"/></mxCell><mxCell id="s60" value="24" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#1f2933;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1254" y="284" width="320" height="30" as="geometry"/></mxCell><mxCell id="s61" value="60 s · 300 s" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#1f2933;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1394" y="284" width="320" height="30" as="geometry"/></mxCell><mxCell id="s62" value="• Each parameter has an id, a unit and a collection interval.&lt;br&gt;• Users do not see this data. When a user's request starts, the Service System copies the service's endpoint and parameters into the message it sends to the Supervisor (step 3).&lt;br&gt;• Credentials are not stored here: the Supervisor's connection profile for each RP holds them." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#1f2933;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="622" y="328" width="1426" height="80" as="geometry"/></mxCell><mxCell id="s63" value="&lt;b&gt;RP connection profile&lt;/b&gt; (once per RP, set up by a platform operator)&lt;br&gt;&lt;span style='font-size:9.5px'&gt;how the Supervisor authenticates to RP-A, trusted certificates, rate limits; credentials in a Kubernetes Secret. Used in step 5.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666