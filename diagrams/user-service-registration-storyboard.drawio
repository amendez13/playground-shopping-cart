mxCell><mxCell id="s143" value="&lt;b&gt;RP-A operator&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10.5;fontColor=#1f2933;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="270" y="608" width="120" height="38" as="geometry"/></mxCell><mxCell id="s144" value="&lt;b&gt;Service System&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;fontColor=#1f2933;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="550" y="608" width="120" height="38" as="geometry"/></mxCell><mxCell id="s145" value="register" style="endArrow=block;endSize=6;html=1;strokeColor=#1f2933;fontSize=10;fontColor=#1f2933;labelBackgroundColor=#fafbfc;fontFamily=Helvetica;" edge="1" parent="1" source="s143" target="s144"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="0" as="sourcePoint"/><mxPoint x="0" y="0" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="s146" value="• The provider registers US-1001 with its endpoint and the 30 parameters, each with unit and collection interval.&lt;br&gt;• The Service System validates and stores them. It is the authority for this data; the Supervisor has no other source." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#1f2933;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="266" y="672" width="408" height="84" as="geometry"/></mxCell><mxCell id="s147" value="&lt;b&gt;Service System&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10.5;fontColor=#1f2933;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="766" y="608" width="120" height="38" as="geometry"/></mxCell><mxCell id="s148" value="&lt;b&gt;AMQP broker&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10.5;fontColor=#1f2933;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="910" y="608" width="120" height="38" as="geometry"/></mxCell><mxCell id="s149" value="&lt;b&gt;Supervisor&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;fontColor=#1f2933;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1054" y="608" width="120" height="38" as="geometry"/></mxCell><mxCell id="s150" value="" style="endArrow=block;endSize=6;html=1;strokeColor=#1f2933;fontSize=10;fontColor=#1f2933;labelBackgroundColor=#fafbfc;fontFamily=Helvetica;" edge="1" parent="1" source="s147" target="s148"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="0" as="sourcePoint"/><mxPoint x="0" y="0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s151" value="" style="endArrow=block;endSize=6;html=1;strokeColor=#1f2933;fontSize=10;fontColor=#1f2933;labelBackgroundColor=#fafbfc;fontFamily=Helvetica;" edge="1" parent="1" source="s148" target="s149"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="0" as="sourcePoint"/><mxPoint x="0" y="0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s152" value="• Published through a transactional outbox after the Service System commits.&lt;br&gt;• The message carries what collection needs: provider, endpoint, connection profile name, and parameter list, versioned by &lt;i&gt;revision&lt;/i&gt;." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#1f2933;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="766" y="672" width="408" height="84" as="geometry"/></mxCell><mxCell id="s153" value="&lt;b&gt;Supervisor&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;fontColor=#1f2933;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1270" y="608" width="120" height="38" as="geometry"/></mxCell><mxCell id="s154" value="&lt;b&gt;PostgreSQL&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;fontColor=#1f2933;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1550" y="608" width="120" height="38" as="geometry"/></mxCell><mxCell id="s155" value="store" style="endArrow=block;endSize=6;html=1;strokeColor=#1f2933;fontSize=10;fontColor=#1f2933;labelBackgroundColor=#fafbfc;fontFamily=Helvetica;" edge="1" parent="1" source="s153" target="s154"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="0" as="sourcePoint"/><mxPoint x="0" y="0" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="s156" value="• Idempotent upsert by user service id and revision; a duplicate or older revision changes nothing.&lt;br&gt;• One Supervisor instance owns US-1001 and materializes due runs per interval class. The same catalogue later feeds the parameter graph." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#1f2933;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1266" y="672" width="408" height="84" as="geometry"/></mxCell><mxCell id="s157" value="&lt;b&gt;Supervisor&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;fontColor=#1f2933;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1766" y="608" width="120" height="38" as="geometry"/></mxCell><mxCell id="s158" value="&lt;b&gt;RP-A&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10.5;fontColor=#1f2933;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1910" y="608" width="120" height="38" as="geometry"/></mxCell><mxCell id="s159" value="&lt;b&gt;Prometheus + Thanos&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9.5;fontColor=#1f2933;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2054" y="608" width="120" height="38" as="geometry"/></mxCell><mxCell id="s160" value="" style="endArrow=block;endSize=6;html=1;strokeColor=#1f2933;fontSize=10;fontColor=#1f2933;labelBackgroundColor=#fafbfc;fontFamily=Helvetica;" edge="1" parent="1" source="s157" target="s158"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="0" as="sourcePoint"/><mxPoint x="0" y="0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s161" value="scrape" style="endArrow=open;dashed=1;endSize=6;html=1;strokeColor=#1f2933;fontSize=10;fontColor=#1f2933;labelBackgroundColor=#fafbfc;fontFamily=Helvetica;" edge="1" parent="1" source="s159" target="s157"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="0" as="sourcePoint"/><mxPoint x="0" y="0" as="targetPoint"/><Array as="points"><mxPoint x="2114" y="658"/><mxPoint x="1826" y="658"/></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="s162" value="• Each due run polls RP-A for the parameters of that interval class.&lt;br&gt;• Values are stored, then exposed on the private /metrics/business endpoint and scraped into Thanos for history." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#1f2933;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1766" y="672" width="408" height="84" as="geometry"/></mxCell><mxCell id="s163" value="" style="rounded=1;arcSize=6;html=1;fillColor=#ffffff;strokeColor=#d4d9e0;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="592" width="160" height="170" as="geometry"/></mxCell><mxCell id="s164" value="&lt;b&gt;Later changes&lt;/b&gt;&lt;br&gt;A new parameter list or endpoint is a new revision (UserServiceUpdated). Removal is UserServiceDeregistered: collection stops." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#1f2933;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="50" y="600" width="142" height="154" as="geometry"/></mxCell><mxCell id="s165" value="&lt;b&gt;Open:&lt;/b&gt; AsyncAPI 3.0.0 contract for the registration events · who provisions the connection profile and Secret for a new provider · validation of parameter ids against the provider's qualified API profile · instance ownership and rebalancing." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#1f2933;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="784" width="2150" height="22" as="geometry"/></mxCell><mxCell id="s166" value="" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="18" height="14" as="geometry"/></mxCell><mxCell id="s167" value="resource provider" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#5f6b7a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="816" width="150" height="22" as="geometry"/></mxCell><mxCell id="s168" value="" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="210" y="820" width="18" height="14" as="geometry"/></mxCell><mxCell id="s169" value="Service System" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#5f6b7a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="234" y="816" width="150" height="22" as="geometry"/></mxCell><mxCell id="s170" value="" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="380" y="820" width="18" height="14" as="geometry"/></mxCell><mxCell id="s171" value="AMQP broker" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#5f6b7a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="404" y="816" width="150" height="22" as="geometry"/></mxCell><mxCell id="s172" value="" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="550" y="820" width="18" height="14" as="geometry"/></mxCell><mxCell id="s173" value="Supervisor-owned" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#5f6b7a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="574" y="816" width="150" height="22" as="geometry"/></mxCell><mxCell id="s174" value="" style="rounded=1;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="720" y="820" width="18" height="14" as="geometry"/></mxCell><mxCell id="s175" value="Prometheus + Thanos" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#5f6b7a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="744" y="816" width="150" height="22" as="geometry"/></mxCell><mxCell id="s176" value="Illustrative proposal; not an approved contract. Message fields and provider API are examples." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#5f6b7a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="816" width="700" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>