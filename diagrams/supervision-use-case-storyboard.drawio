er1 signs in; Keycloak returns the tokens to Traefik, which keeps them in its session store.&lt;br&gt;• The browser gets only an HttpOnly session cookie." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#1f2933;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="276" y="622" width="438" height="74" as="geometry"/></mxCell><mxCell id="s143" value="Sequence detail: list diagram, steps 1–7" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=9.5;fontColor=#5f6b7a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="276" y="718" width="438" height="24" as="geometry"/></mxCell><mxCell id="s144" value="&lt;b&gt;Supervisor&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px'&gt;Supervision Data API&lt;/span&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#1f2933;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="840" y="588" width="120" height="46" as="geometry"/></mxCell><mxCell id="s145" value="&lt;b&gt;Service System&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1f2933;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="558" width="150" height="40" as="geometry"/></mxCell><mxCell id="s146" value="&lt;b&gt;Supervisor PostgreSQL&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;fontColor=#1f2933;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="624" width="150" height="40" as="geometry"/></mxCell><mxCell id="s147" value="1 · visible services" style="endArrow=block;endSize=6;html=1;strokeColor=#1f2933;fontSize=10;fontColor=#1f2933;labelBackgroundColor=#fafbfc;fontFamily=Helvetica;" edge="1" parent="1" source="s144" target="s145"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="0" as="sourcePoint"/><mxPoint x="0" y="0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s148" value="2 · status, freshness" style="endArrow=block;endSize=6;html=1;strokeColor=#1f2933;fontSize=10;fontColor=#1f2933;labelBackgroundColor=#fafbfc;fontFamily=Helvetica;" edge="1" parent="1" source="s144" target="s146"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="0" as="sourcePoint"/><mxPoint x="0" y="0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s149" value="• The Supervisor asks the Service System which user services g-user1 may see (token exchange) and caches the answer.&lt;br&gt;• It adds provider, status and last collection time from its own PostgreSQL and returns the list." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#1f2933;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="836" y="676" width="438" height="74" as="geometry"/></mxCell><mxCell id="s150" value="Sequence detail: list diagram, steps 8–20" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=9.5;fontColor=#5f6b7a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="836" y="718" width="438" height="24" as="geometry"/></mxCell><mxCell id="s151" value="&lt;b&gt;Supervisor&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px'&gt;Supervision Data API&lt;/span&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#1f2933;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1400" y="588" width="120" height="46" as="geometry"/></mxCell><mxCell id="s152" value="&lt;b&gt;Supervisor PostgreSQL&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10.5;fontColor=#1f2933;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1680" y="558" width="150" height="40" as="geometry"/></mxCell><mxCell id="s153" value="&lt;b&gt;Prometheus + Thanos&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10.5;fontColor=#1f2933;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1680" y="624" width="150" height="40" as="geometry"/></mxCell><mxCell id="s154" value="1 · parameter catalogue" style="endArrow=block;endSize=6;html=1;strokeColor=#1f2933;fontSize=10;fontColor=#1f2933;labelBackgroundColor=#fafbfc;fontFamily=Helvetica;" edge="1" parent="1" source="s151" target="s152"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="0" as="sourcePoint"/><mxPoint x="0" y="0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s155" value="2 · history (query_range)" style="endArrow=block;endSize=6;html=1;strokeColor=#1f2933;fontSize=10;fontColor=#1f2933;labelBackgroundColor=#fafbfc;fontFamily=Helvetica;" edge="1" parent="1" source="s151" target="s153"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="0" as="sourcePoint"/><mxPoint x="0" y="0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s156" value="• The Supervisor checks US-1001 against the cached visibility, reads the parameter catalogue, and queries Thanos for the selected range.&lt;br&gt;• The chart draws the series and asks for new points every 15–30 s." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;fontColor=#1f2933;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1396" y="676" width="438" height="74" as="geometry"/></mxCell><mxCell id="s157" value="Sequence detail: parameter graph diagram" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=9.5;fontColor=#5f6b7a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1396" y="718" width="438" height="24" as="geometry"/></mxCell><mxCell id="s158" value="" style="rounded=1;arcSize=6;html=1;fillColor=#ffffff;strokeColor=#d4d9e0;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="542" width="150" height="210" as="geometry"/></mxCell><mxCell id="s159" value="&lt;b&gt;Every browser call&lt;/b&gt;&lt;br&gt;goes to Traefik with the session cookie. Traefik forwards it to the Supervisor with the user's access token.&lt;br&gt;&lt;br&gt;The browser never calls Keycloak's API, the Service System or Thanos directly." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#1f2933;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="50" y="552" width="130" height="190" as="geometry"/></mxCell><mxCell id="s160" value="" style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="18" height="14" as="geometry"/></mxCell><mxCell id="s161" value="browser" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#5f6b7a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="64" y="776" width="150" height="22" as="geometry"/></mxCell><mxCell id="s162" value="" style="rounded=1;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="190" y="780" width="18" height="14" as="geometry"/></mxCell><mxCell id="s163" value="Traefik" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#5f6b7a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="214" y="776" width="150" height="22" as="geometry"/></mxCell><mxCell id="s164" value="" style="rounded=1;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="340" y="780" width="18" height="14" as="geometry"/></mxCell><mxCell id="s165" value="Keycloak" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#5f6b7a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="364" y="776" width="150" height="22" as="geometry"/></mxCell><mxCell id="s166" value="" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="490" y="780" width="18" height="14" as="geometry"/></mxCell><mxCell id="s167" value="Supervisor-owned" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#5f6b7a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="514" y="776" width="150" height="22" as="geometry"/></mxCell><mxCell id="s168" value="" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="640" y="780" width="18" height="14" as="geometry"/></mxCell><mxCell id="s169" value="Service System" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#5f6b7a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="664" y="776" width="150" height="22" as="geometry"/></mxCell><mxCell id="s170" value="" style="rounded=1;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="790" y="780" width="18" height="14" as="geometry"/></mxCell><mxCell id="s171" value="Prometheus + Thanos" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#5f6b7a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="814" y="776" width="150" height="22" as="geometry"/></mxCell><mxCell id="s172" value="Illustrative proposal (ADR 0005, ADR 0006); not a UI design." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#5f6b7a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="950" y="776" width="600" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>