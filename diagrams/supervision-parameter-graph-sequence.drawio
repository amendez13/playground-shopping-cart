<mxfile host="drawio" version="24.7.17"><diagram id="supervision-parameter-graph" name="Supervision parameter graph"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1530" pageHeight="2440" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Supervision parameter graph: populate and refresh a user service's chart from Prometheus + Thanos&lt;/b&gt; (illustrative proposal; history lives in Thanos, not in the Supervisor)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1480" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;signed in&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="-15" y="80" width="170" height="60" as="geometry"/></mxCell><mxCell id="c3" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="140" as="sourcePoint"/><mxPoint x="70" y="1230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c4" value="&lt;b&gt;Supervision micro frontend&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Angular / TypeScript, chart&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="179" y="80" width="170" height="60" as="geometry"/></mxCell><mxCell id="c5" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="264" y="140" as="sourcePoint"/><mxPoint x="264" y="1230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="&lt;b&gt;Traefik&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;API gateway + Ingress, OIDC session&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="568" y="80" width="170" height="60" as="geometry"/></mxCell><mxCell id="c7" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="653" y="140" as="sourcePoint"/><mxPoint x="653" y="1230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;Supervisor&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Supervision Data API ·&lt;br&gt;/metrics/business&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="762" y="80" width="170" height="60" as="geometry"/></mxCell><mxCell id="c9" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="847" y="140" as="sourcePoint"/><mxPoint x="847" y="1230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="&lt;b&gt;Keycloak&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="374" y="80" width="170" height="60" as="geometry"/></mxCell><mxCell id="c11" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="459" y="140" as="sourcePoint"/><mxPoint x="459" y="1230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="&lt;b&gt;Service System&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;owns user ↔ service mapping&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="956" y="80" width="170" height="60" as="geometry"/></mxCell><mxCell id="c13" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1041" y="140" as="sourcePoint"/><mxPoint x="1041" y="1230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;Supervisor PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;parameter catalogue&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1151" y="80" width="170" height="60" as="geometry"/></mxCell><mxCell id="c15" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1236" y="140" as="sourcePoint"/><mxPoint x="1236" y="1230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;Prometheus + Thanos&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Query · Sidecar/Receive ·&lt;br&gt;Store Gateway → S3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1345" y="80" width="170" height="60" as="geometry"/></mxCell><mxCell id="c17" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1430" y="140" as="sourcePoint"/><mxPoint x="1430" y="1230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="740" y="160" width="775" height="105" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;loop&lt;/b&gt; [one scrape job per interval class: every 10 s / 60 s / 300 s; independent of users]" style="shape=card;size=8;html=1;fillColor=#eeeeee;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="740" y="160" width="560" height="22" as="geometry"/></mxCell><mxCell id="c20" value="1. GET /metrics/business?interval=10s, 60s or 300s (scrape, private) [A1]" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#b85450;fontColor=#8a2f2a;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1430" y="200" as="sourcePoint"/><mxPoint x="847" y="200" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c21" value="2. 200 latest values of that class → Thanos keeps history (network disk, then S3 blocks)" style="endArrow=open;html=1;rounded=0;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#b85450;fontColor=#8a2f2a;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="847" y="240" as="sourcePoint"/><mxPoint x="1430" y="240" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c22" value="precondition: signed in (list diagram steps 1–7); browser holds only the session cookie, Traefik holds the tokens" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="278" y="276" width="360" height="40" as="geometry"/></mxCell><mxCell id="c23" value="3. open graph for US1" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="340" as="sourcePoint"/><mxPoint x="264" y="340" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c24" value="4. GET …/user-services/US1/parameters (cookie) [A2]" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="264" y="370" as="sourcePoint"/><mxPoint x="653" y="370" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c25" value="5. session → Bearer token; JWT, audience, read checked" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="653" y="400" as="sourcePoint"/><mxPoint x="847" y="400" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c26" value="6. re-validate JWT; US1 within the scope cached by the list call (all, or listed ids)?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="717" y="410" width="260" height="56" as="geometry"/></mxCell><mxCell id="c27" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="360" y="475" width="1155" height="165" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;alt&lt;/b&gt; [US1 not within the cached scope: fallback]" style="shape=card;size=8;html=1;fillColor=#eeeeee;strokeColor=#333333;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="360" y="475" width="380" height="22" as="geometry"/></mxCell><mxCell id="c29" value="7. token exchange → aud=service-system" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="847" y="520" as="sourcePoint"/><mxPoint x="459" y="520" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c30" value="8. exchanged token (same user)" style="endArrow=open;html=1;rounded=0;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="459" y="548" as="sourcePoint"/><mxPoint x="847" y="548" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c31" value="9. GET /service-system/v1/user-services/US1 [A3]" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="847" y="575" as="sourcePoint"/><mxPoint x="1041" y="575" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c32" value="10. 200 visible · 404 not visible · 403 no access · 503 [E]" style="endArrow=open;html=1;rounded=0;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1041" y="615" as="sourcePoint"/><mxPoint x="847" y="615" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c33" value="11. SQL: parameter catalogue for US1" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="847" y="670" as="sourcePoint"/><mxPoint x="1236" y="670" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c34" value="12. rows" style="endArrow=open;html=1;rounded=0;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1236" y="700" as="sourcePoint"/><mxPoint x="847" y="700" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c35" value="13. 200 parameters: id, unit, collection interval, via Traefik [A2]" style="endArrow=open;html=1;rounded=0;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="847" y="735" as="sourcePoint"/><mxPoint x="264" y="735" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c36" value="14. GET …/US1/series?parameters=…&amp;from&amp;to (cookie) [A4]" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="264" y="775" as="sourcePoint"/><mxPoint x="653" y="775" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c37" value="15. forward + Bearer (checked)" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="653" y="805" as="sourcePoint"/><mxPoint x="847" y="805" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c38" value="16. visibility (cached) → 404 · unknown parameter or range → 400 · pick step from range and collection interval" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="722" y="818" width="250" height="62" as="geometry"/></mxCell><mxCell id="c39" value="17. Thanos Query: GET /api/v1/query_range (server-built PromQL) [A5]" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="847" y="905" as="sourcePoint"/><mxPoint x="1430" y="905" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c40" value="18. 200 matrix (store unreachable → partial + warning; Query down → 503)" style="endArrow=open;html=1;rounded=0;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1430" y="935" as="sourcePoint"/><mxPoint x="847" y="935" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c41" value="19. 200 series, &quot;partial&quot; flag, via Traefik [A4] · errors [E]" style="endArrow=open;html=1;rounded=0;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="847" y="970" as="sourcePoint"/><mxPoint x="264" y="970" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c42" value="20. draw chart" style="endArrow=open;html=1;rounded=0;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="264" y="1000" as="sourcePoint"/><mxPoint x="70" y="1000" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c43" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="1020" width="1495" height="195" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;loop&lt;/b&gt; [every 15–30 s while the graph is open]" style="shape=card;size=8;html=1;fillColor=#eeeeee;strokeColor=#333333;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20" y="1020" width="290" height="22" as="geometry"/></mxCell><mxCell id="c45" value="21. GET …/series?…&amp;from=&amp;lt;last point&amp;gt; (cookie) [A4]" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="264" y="1060" as="sourcePoint"/><mxPoint x="653" y="1060" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c45b" value="22. forward + Bearer; checks as 15–16" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="653" y="1090" as="sourcePoint"/><mxPoint x="847" y="1090" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c46" value="23. query_range, short window (recent data: Sidecar/Receive)" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="847" y="1120" as="sourcePoint"/><mxPoint x="1430" y="1120" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c47" value="24. new samples" style="endArrow=open;html=1;rounded=0;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1430" y="1145" as="sourcePoint"/><mxPoint x="847" y="1145" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c48" value="25. 200 new points, via Traefik [A4]" style="endArrow=open;html=1;rounded=0;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="847" y="1170" as="sourcePoint"/><mxPoint x="264" y="1170" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c49" value="26. append to chart" style="endArrow=open;html=1;rounded=0;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="264" y="1198" as="sourcePoint"/><mxPoint x="70" y="1198" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c50" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;• History lives in Prometheus + Thanos (network disk, blocks uploaded to S3). The Supervisor PostgreSQL holds no long-term history and the resource providers are not queried for it. Collection runs continuously per user service; the scrape is the only path into history.&lt;br&gt;• The browser never queries Prometheus, Thanos, or Grafana. Only the Supervisor may call Thanos Query (NetworkPolicy; authentication method open). PromQL is built on the server from allowlisted parameter ids and the visible path id, never from user text.&lt;br&gt;• The list call caches the user's scope from the Service System (all, or listed ids; TTL open); the Supervisor never interprets business roles. Steps 7–10 run only on a miss (deep link, later page, expiry, other replica, new grant). Every series call repeats the check → &lt;b&gt;404&lt;/b&gt; if not visible.&lt;br&gt;• Thanos Query down → &lt;b&gt;503&lt;/b&gt; (degraded visibility, ADR 0004; collection unaffected). A store unreachable (for example S3) → &lt;b&gt;200&lt;/b&gt; with &lt;font face='Courier New'&gt;&quot;partial&quot;: true&lt;/font&gt; and the data that is available.&lt;br&gt;• One scrape job per interval class, so each value is stored once at its own interval. 30 series per user service; e.g. 5,000 services → 150,000 series. The &lt;font face='Courier New'&gt;user_service_id&lt;/font&gt; label needs approval under ADR 0004.  Green = Supervisor-owned · red = Prometheus/Thanos · dashed = response." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#fafafa;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1255" width="1495" height="112" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;REST APIs involved — example requests and responses&lt;/b&gt; (hosts, ids, values and tokens are fake placeholders; queries shown unencoded; token exchange as in the list diagram [A5])" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="1405" width="1495" height="30" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;[A1] Supervisor business metrics&lt;/b&gt; (Prometheus exposition, scraped; private, never routed publicly)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="1445" width="992" height="26" as="geometry"/></mxCell><mxCell id="c53" value="&lt;font face='Courier New' style='font-size:10px'&gt;GET&amp;nbsp;/metrics/business?interval=10s&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(one&amp;nbsp;Prometheus&amp;nbsp;scrape&amp;nbsp;job&amp;nbsp;per&amp;nbsp;class:&amp;nbsp;10s&amp;nbsp;/&amp;nbsp;60s&amp;nbsp;/&amp;nbsp;300s)&lt;br&gt;-&amp;gt;&amp;nbsp;200&amp;nbsp;OK&lt;br&gt;Content-Type:&amp;nbsp;text/plain;&amp;nbsp;version=0.0.4&lt;br&gt;&lt;br&gt;#&amp;nbsp;HELP&amp;nbsp;supervision_parameter_value&amp;nbsp;Latest&amp;nbsp;approved&amp;nbsp;value&amp;nbsp;of&amp;nbsp;a&amp;nbsp;supervised&amp;nbsp;parameter&amp;nbsp;(unit&amp;nbsp;in&amp;nbsp;the&amp;nbsp;parameter&amp;nbsp;catalogue).&lt;br&gt;#&amp;nbsp;TYPE&amp;nbsp;supervision_parameter_value&amp;nbsp;gauge&lt;br&gt;supervision_parameter_value{user_service_id=&amp;quot;US1&amp;quot;,parameter=&amp;quot;latency_ms&amp;quot;}&amp;nbsp;12.4&lt;br&gt;supervision_parameter_value{user_service_id=&amp;quot;US1&amp;quot;,parameter=&amp;quot;jitter_ms&amp;quot;}&amp;nbsp;1.8&lt;br&gt;supervision_parameter_value{user_service_id=&amp;quot;US2&amp;quot;,parameter=&amp;quot;latency_ms&amp;quot;}&amp;nbsp;9.7&lt;br&gt;#&amp;nbsp;HELP&amp;nbsp;supervision_parameter_collected_timestamp_seconds&amp;nbsp;When&amp;nbsp;the&amp;nbsp;exposed&amp;nbsp;value&amp;nbsp;was&amp;nbsp;collected.&lt;br&gt;#&amp;nbsp;TYPE&amp;nbsp;supervision_parameter_collected_timestamp_seconds&amp;nbsp;gauge&lt;br&gt;supervision_parameter_collected_timestamp_seconds{user_service_id=&amp;quot;US1&amp;quot;,parameter=&amp;quot;latency_ms&amp;quot;}&amp;nbsp;1763289592&lt;br&gt;&lt;br&gt;Metric&amp;nbsp;and&amp;nbsp;label&amp;nbsp;names&amp;nbsp;are&amp;nbsp;illustrative;&amp;nbsp;the&amp;nbsp;catalogue&amp;nbsp;is&amp;nbsp;still&amp;nbsp;open&amp;nbsp;under&amp;nbsp;ADR&amp;nbsp;0004.&lt;br&gt;Each&amp;nbsp;class&amp;nbsp;is&amp;nbsp;scraped&amp;nbsp;at&amp;nbsp;its&amp;nbsp;own&amp;nbsp;collection&amp;nbsp;interval,&amp;nbsp;so&amp;nbsp;a&amp;nbsp;value&amp;nbsp;is&amp;nbsp;stored&amp;nbsp;once,&amp;nbsp;not&amp;nbsp;repeated.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="1471" width="992" height="304" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;[A2] Parameter catalogue&lt;/b&gt; (Supervision Data API)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;rounded=0;" vertex="1" parent="1"><mxGeometry x="1024" y="1445" width="490" height="26" as="geometry"/></mxCell><mxCell id="c55" value="&lt;font face='Courier New' style='font-size:10px'&gt;GET&amp;nbsp;/supervision/v1/user-services/US1/parameters&lt;br&gt;Authorization:&amp;nbsp;Bearer&amp;nbsp;eyJhbGciOiJSUzI1NiIs…&amp;nbsp;&amp;nbsp;(added&amp;nbsp;by&amp;nbsp;Traefik;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp