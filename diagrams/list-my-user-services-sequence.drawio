<mxfile host="drawio" version="24.7.17"><diagram id="list-my-user-services" name="List my user services"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="2280" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;List user services visible to the caller: authentication and visibility&lt;/b&gt; (illustrative proposal; visibility model provisional)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;User (browser)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;business roles, e.g. c-admin, go-user&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="-10.0" y="80" width="180" height="60" as="geometry"/></mxCell><mxCell id="c3" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="140" as="sourcePoint"/><mxPoint x="80" y="1060" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c4" value="&lt;b&gt;Supervision micro frontend&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Angular / TypeScript, no tokens&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="190.0" y="80" width="180" height="60" as="geometry"/></mxCell><mxCell id="c5" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="140" as="sourcePoint"/><mxPoint x="280" y="1060" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="&lt;b&gt;Keycloak&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="400.0" y="80" width="180" height="60" as="geometry"/></mxCell><mxCell id="c7" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="140" as="sourcePoint"/><mxPoint x="490" y="1060" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;Traefik&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;API gateway + Ingress, OIDC session&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="590.0" y="80" width="180" height="60" as="geometry"/></mxCell><mxCell id="c9" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="140" as="sourcePoint"/><mxPoint x="680" y="1060" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="&lt;b&gt;Supervision Data API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;user-facing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="790.0" y="80" width="180" height="60" as="geometry"/></mxCell><mxCell id="c11" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="140" as="sourcePoint"/><mxPoint x="880" y="1060" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="&lt;b&gt;Service System&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;owns user ↔ service mapping&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1020.0" y="80" width="180" height="60" as="geometry"/></mxCell><mxCell id="c13" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1110" y="140" as="sourcePoint"/><mxPoint x="1110" y="1060" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;Supervisor PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;user service → resource provider&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1240.0" y="80" width="180" height="60" as="geometry"/></mxCell><mxCell id="c15" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1330" y="140" as="sourcePoint"/><mxPoint x="1330" y="1060" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1"><mxGeometry x="15" y="160" width="1440" height="250" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Login&lt;/b&gt; (Traefik holds the tokens)" style="text;html=1;align=left;fontSize=11;fontColor=#8a5a00;" vertex="1" parent="1"><mxGeometry x="20" y="162" width="300" height="20" as="geometry"/></mxCell><mxCell id="c18" value="1. open HMI Supervision view (no session cookie)" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=none;fontSize=11;strokeColor=#d79b00;fontColor=#8a5a00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="195" as="sourcePoint"/><mxPoint x="680" y="195" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c19" value="2. 302 → GET …/openid-connect/auth (client hmi-gateway, code + PKCE) [A1]" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=none;fontSize=11;strokeColor=#d79b00;fontColor=#8a5a00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="228" as="sourcePoint"/><mxPoint x="490" y="228" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c20" value="3. sign in on Keycloak login page (password / MFA)" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=none;fontSize=11;strokeColor=#d79b00;fontColor=#8a5a00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="262" as="sourcePoint"/><mxPoint x="490" y="262" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c21" value="4. 302 → Traefik callback ?code=…&amp;state=… [A1]" style="endArrow=open;html=1;rounded=0;dashed=1;labelBackgroundColor=none;fontSize=11;strokeColor=#d79b00;fontColor=#8a5a00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="296" as="sourcePoint"/><mxPoint x="680" y="296" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c22" value="5. POST …/openid-connect/token (code + verifier + client secret) [A2]" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=none;fontSize=11;strokeColor=#d79b00;fontColor=#8a5a00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="328" as="sourcePoint"/><mxPoint x="490" y="328" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c23" value="6. 200 access + refresh + id token → kept in Traefik session store" style="endArrow=open;html=1;rounded=0;dashed=1;labelBackgroundColor=none;fontSize=11;strokeColor=#d79b00;fontColor=#8a5a00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="358" as="sourcePoint"/><mxPoint x="680" y="358" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c24" value="7. 302 to page + Set-Cookie __Host-hmi_session (HttpOnly) [A2]" style="endArrow=open;html=1;rounded=0;dashed=1;labelBackgroundColor=none;fontSize=11;strokeColor=#d79b00;fontColor=#8a5a00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="392" as="sourcePoint"/><mxPoint x="280" y="392" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c25" value="8. GET /supervision/v1/user-services?pageSize=50 (cookie only) [A4]" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=none;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="438" as="sourcePoint"/><mxPoint x="680" y="438" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c26" value="9. session lookup; refresh if near expiry; check JWT (JWKS cached [A3]), audience, supervision-api:read" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545.0" y="452" width="270" height="50" as="geometry"/></mxCell><mxCell id="c27" value="10. forward + Authorization: Bearer &amp;lt;access token&amp;gt; [A4]" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=none;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="522" as="sourcePoint"/><mxPoint x="880" y="522" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c28" value="11. re-validate JWT; scope cached for this user? (no business-role logic)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="755.0" y="535" width="250" height="36" as="geometry"/></mxCell><mxCell id="c29" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="390" y="585" width="1065" height="300" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;alt&lt;/b&gt; [scope not cached]" style="shape=card;size=8;html=1;fillColor=#eeeeee;strokeColor=#333333;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="390" y="585" width="230" height="22" as="geometry"/></mxCell><mxCell id="c31" value="12. POST …/openid-connect/token (token exchange → aud=service-system) [A5]" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=none;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="625" as="sourcePoint"/><mxPoint x="490" y="625" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c32" value="13. 200 exchanged token (same user)" style="endArrow=open;html=1;rounded=0;dashed=1;labelBackgroundColor=none;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="657" as="sourcePoint"/><mxPoint x="880" y="657" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c33" value="14. GET /service-system/v1/user-services?pageSize=50&amp;fields=userServiceId [A6]" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=none;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="693" as="sourcePoint"/><mxPoint x="1110" y="693" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c34" value="15. map business roles (c-admin, go-user, …) + ownership → scope: all · listed ids · no access" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="995.0" y="710" width="230" height="62" as="geometry"/></mxCell><mxCell id="c35" value="16. 200 scope (+ ids page)  ·  403 no access  ·  503 unavailable [E]" style="endArrow=open;html=1;rounded=0;dashed=1;labelBackgroundColor=none;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1110" y="792" as="sourcePoint"/><mxPoint x="880" y="792" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c36" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="815" as="sourcePoint"/><mxPoint x="1455" y="815" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="[scope cached]" style="text;html=1;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="395" y="817" width="120" height="20" as="geometry"/></mxCell><mxCell id="c38" value="no lookup: use cached scope (all, or listed ids)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="765.0" y="840" width="230" height="36" as="geometry"/></mxCell><mxCell id="c39" value="17. SQL: provider, status, freshness for the ids, or all (paged; not REST)" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=none;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="915" as="sourcePoint"/><mxPoint x="1330" y="915" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c40" value="18. rows" style="endArrow=open;html=1;rounded=0;dashed=1;labelBackgroundColor=none;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1330" y="945" as="sourcePoint"/><mxPoint x="880" y="945" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c41" value="19. 200 page of user services, via Traefik [A4]  ·  errors [E]" style="endArrow=open;html=1;rounded=0;dashed=1;labelBackgroundColor=none;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="980" as="sourcePoint"/><mxPoint x="280" y="980" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c42" value="20. show list" style="endArrow=open;html=1;rounded=0;dashed=1;labelBackgroundColor=none;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="1015" as="sourcePoint"/><mxPoint x="80" y="1015" as="targetPoint"/><mxPoint x="0" y="-9" as="offset"/></mxGeometry></mxCell><mxCell id="c43" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;• The browser holds only the HttpOnly session cookie. Traefik (gateway + Ingress) is the confidential Keycloak client: it keeps tokens in a server-side session store, refreshes them, and forwards the real access token as Bearer. The Supervisor re-validates it and uses it for token exchange.&lt;br&gt;• Service System unavailable at step 14 → &lt;b&gt;503&lt;/b&gt;; never fall back to showing all services.&lt;br&gt;• Every per-service call (e.g. &lt;font face='Courier New'&gt;GET /supervision/v1/user-services/{id}/…&lt;/font&gt;) repeats the visibility check → &lt;b&gt;404&lt;/b&gt; if not visible. One collection for every role: results depend on the caller's visibility (admins see all). The scope answer is cached per user (TTL open).&lt;br&gt;• The Supervisor stores no user ids and does not interpret business roles (c-admin, c-operator, e-admin, e-operator, g-manager, g-operator, go-user). The Service System maps them, plus ownership, to a scope: &lt;b&gt;all&lt;/b&gt;, &lt;b&gt;listed&lt;/b&gt; ids, or &lt;b&gt;403&lt;/b&gt;. The only role the Supervisor and gateway check is the technical &lt;font face='Courier New'&gt;supervision-api:read&lt;/font&gt; (may call the API only), granted to every HMI user.&lt;br&gt;• Green = Supervisor-owned · orange = login · dashed = response. Token exchange requires Keycloak 26.2+ standard token exchange (verify for the selected version)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#fafafa;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1090" width="1435" height="120" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;REST APIs involved — example requests and responses&lt;/b&gt; (realm, hosts, ids, and tokens are fake placeholders; tokens truncated)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="1230" width="1435" height="30" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;[A1] Keycloak authorization endpoint&lt;/b&gt; (browser redirect started by Traefik)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;fontSize=11;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="1270" width="470" height="26" as="geometry"/></mxCell><mxCell id="c46" value="&lt;font face='Courier New' style='font-size:10px'&gt;GET&amp;nbsp;/realms/platform/protocol/openid-connect/auth&lt;br&gt;&amp;nbsp;&amp;nbsp;?response_type=code&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;amp;client_id=hmi-gateway&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;amp;redirect_uri=https://hmi.example.test/oauth2/callback&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;amp;scope=openid&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;amp;state=af0ifjsldkj&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;amp;code_challenge=E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;amp;code_challenge_method=S256&lt;br&gt;&lt;br&gt;-&amp;gt;&amp;nbsp;200&amp;nbsp;Keycloak&amp;nbsp;login&amp;nbsp;page&amp;nbsp;(user&amp;nbsp;signs&amp;nbsp;in)&lt;br&gt;&lt;br&gt;-&amp;gt;&amp;nbsp;302&amp;nbsp;Found&lt;br&gt;Location:&amp;nbsp;https://hmi.example.test/oauth2/callback&lt;br&gt;&amp;nbsp;&amp;nbsp;?code=SplxlOBeZQQYbYS6WxSbIA&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;amp;state=af0ifjsldkj&lt;br&gt;(state&amp;nbsp;and&amp;nbsp;PKCE&amp;nbsp;verifier&amp;nbsp;kept&amp;nbsp;by&amp;nbsp;Traefik,&amp;nbsp;not&amp;nbsp;by&amp;nbsp;the&amp;nbsp;browser)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="1296" width="470" height="314" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;[A2] Keycloak token endpoint&lt;/b&gt; (Traefik, confidential client) + session cookie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;fontSize=11;rounded=0;" vertex="1" parent="1"><mxGeometry x="502" y="1270" width="470" height="26" as="geometry"/></mxCell><mxCell id="c48" value="&lt;font face='Courier New' style='font-size:10px'&gt;POST&amp;nbsp;/realms/platform/protocol/openid-connect/token&lt;br&gt;Authorization:&amp;nbsp;Basic&amp;nbsp;&amp;lt;hmi-gateway&amp;nbsp;client&amp;nbsp;credentials&amp;gt;&lt;br&gt;Content-Type:&amp;nbsp;application/x-www-form-urlencoded&lt;br&gt;&lt;br&gt;grant_type=authorization_code&lt;br&gt;&amp;amp;code=SplxlOBeZQQYbYS6WxSbIA&lt;br&gt;&amp;amp;redirect_uri=https://hmi.example.test/oauth2/callback&lt;br&gt;&amp;amp;code_verifier=dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk&lt;br&gt;&lt;br&gt;-&amp;gt;&amp;nbsp;200&amp;nbsp;OK&lt;br&gt;{&amp;nbsp;&amp;quot;access_token&amp;quot;:&amp;nbsp;&amp;quot;eyJhbGciOiJSUzI1NiIs…&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;token_type&amp;quot;:&amp;nbsp;&amp;quot;Bearer&amp;quot;,&amp;nbsp;&amp;quot;expires_in&amp;quot;:&amp;nbsp;300,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;refresh_token&amp;quot;:&amp;nbsp;&amp;quot;eyJhbGciOiJIUzUxMiIs…&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;id_token&amp;quot;:&amp;nbsp;&amp;quot;eyJhbGciOiJSUzI1NiIs…&amp;quot;&amp;nbsp;}&lt;br&gt;Tokens&amp;nbsp;stay&amp;nbsp;in&amp;nbsp;Traefik&amp;#x27;s&amp;nbsp;session&amp;nbsp;store.&lt;br&gt;&lt;br&gt;Traefik&amp;nbsp;-&amp;gt;&amp;nbsp;browser:&lt;br&gt;302&amp;nbsp;Found&amp;nbsp;&amp;nbsp;Location:&amp;nbsp;/supervision/&lt;br&gt;Set-Cookie:&amp;nbsp;__Host-hmi_session=7f3c…;&amp;nbsp;Path=/;&lt;br&gt;&amp;nbsp;&amp;nbsp;Secure;&amp;nbsp;HttpOnly;&amp;nbsp;SameSite=Lax&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="502" y="1296" width="470" height="314" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;[A3] Keycloak JWKS&lt;/b&gt; + decoded user access token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;fontSize=11;rounded=0;" vertex="1" parent="1"><mxGeometry x="984" y="1270" width="470" height="26" as="geometry"/></mxCell><mxCell id="c50" value="&lt;font face='Courier New' style='font-size:10px'&gt;GET&amp;nbsp;/realms/platform/protocol/openid-conn