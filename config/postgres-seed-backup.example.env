# Copy this file to config/postgres-seed-backup.local.env and fill in the
# project-specific S3 location for the PostgreSQL seed dump.
#
# The local file is intentionally ignored by git.

PSC_SEED_S3_BUCKET=example-bucket-name
PSC_SEED_S3_PREFIX=example/project/prefix/playground_shopping_cart_seed_<UTC-timestamp>
PSC_SEED_DUMP_OBJECT=playground_shopping_cart_seed_<UTC-timestamp>.dump
PSC_SEED_SHA256_OBJECT=playground_shopping_cart_seed_<UTC-timestamp>.dump.sha256
